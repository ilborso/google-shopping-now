{
    "title": "Google Shopping Now Input",
    "type": "object",
    "schemaVersion": 1,
    "required": [
        "query"
    ],
    "properties": {
        "query": {
            "title": "Search Query",
            "sectionCaption": "Search",
            "type": "string",
            "description": "The search query for Google Shopping (e.g. 'laptop', 'wireless headphones'). URL-encoding is handled automatically.",
            "editor": "textfield",
            "prefill": "laptop"
        },
        "min_price": {
            "title": "Minimum Price",
            "sectionCaption": "Price & Filters",
            "type": "integer",
            "description": "Filter results by minimum price (in the currency of the target country). Leave empty for no minimum.",
            "editor": "number",
            "nullable": true
        },
        "max_price": {
            "title": "Maximum Price",
            "type": "integer",
            "description": "Filter results by maximum price (in the currency of the target country). Leave empty for no maximum.",
            "editor": "number",
            "nullable": true
        },
        "sort_by": {
            "title": "Sort By",
            "type": "string",
            "description": "Sort order for shopping results.",
            "editor": "select",
            "nullable": true,
            "enum": [
                "0",
                "1",
                "2"
            ],
            "enumTitles": [
                "Relevance (default)",
                "Price: Low to High",
                "Price: High to Low"
            ]
        },
        "free_shipping": {
            "title": "Free Shipping Only",
            "type": "boolean",
            "description": "If enabled, only show products with free shipping.",
            "default": false,
            "editor": "checkbox"
        },
        "on_sale": {
            "title": "On Sale Only",
            "type": "boolean",
            "description": "If enabled, only show products that are currently on sale.",
            "default": false,
            "editor": "checkbox"
        },
        "max_results": {
            "title": "Max Results",
            "sectionCaption": "Output",
            "type": "integer",
            "description": "Maximum number of product results to return. Leave empty to return all available results.",
            "editor": "number",
            "nullable": true
        },
