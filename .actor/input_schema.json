            "type": "string",
            "description": "The Google domain to use for the search query.",
            "editor": "select",
            "default": "google.com",
            "prefill": "google.com",
            "enum": [
                "google.com", "google.co.uk", "google.ca", "google.com.au",
                "google.de", "google.fr", "google.it", "google.es",
                "google.co.jp", "google.co.kr", "google.com.br", "google.com.mx",
                "google.co.in", "google.ru", "google.nl", "google.be",
