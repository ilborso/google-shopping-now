{
    "title": "Google Shopping Now Input",
    "type": "object",
    "schemaVersion": 1,
    "required": ["query"],
    "properties": {
        "query": {
            "title": "Search Query",
            "sectionCaption": "Search",
            "type": "string",
            "description": "The search query for Google Shopping (e.g. 'laptop', 'wireless headphones'). URL-encoding is handled automatically.",
            "editor": "textfield",
            "prefill": "laptop"
        },
        "min_price": {
            "title": "Minimum Price",
            "sectionCaption": "Price & Filters",
            "type": "integer",
            "description": "Filter results by minimum price (in the currency of the target country). Leave empty for no minimum.",
            "editor": "number",
            "nullable": true
        },
        "max_price": {
            "title": "Maximum Price",
            "type": "integer",
            "description": "Filter results by maximum price (in the currency of the target country). Leave empty for no maximum.",
            "editor": "number",
            "nullable": true
        },
        "sort_by": {
            "title": "Sort By",
            "type": "string",
            "description": "Sort order for shopping results.",
            "editor": "select",
            "nullable": true,
            "enum": ["0", "1", "2"],
            "enumTitles": [
                "Relevance (default)",
                "Price: Low to High",
                "Price: High to Low"
            ]
        },
        "free_shipping": {
            "title": "Free Shipping Only",
            "type": "boolean",
            "description": "If enabled, only show products with free shipping.",
            "default": false,
            "editor": "checkbox"
        },
        "on_sale": {
            "title": "On Sale Only",
            "type": "boolean",
            "description": "If enabled, only show products that are currently on sale.",
            "default": false,
            "editor": "checkbox"
        },
        "max_results": {
            "title": "Max Results",
            "sectionCaption": "Output",
            "type": "integer",
            "description": "Maximum number of product results to return. Leave empty to return all available results.",
            "editor": "number",
            "nullable": true
        },
        "hl": {
            "title": "Language",
            "sectionCaption": "Localization",
            "type": "string",
            "description": "Host language for the Google Shopping results.",
            "editor": "select",
            "default": "en",
            "prefill": "en",
            "enum": [
                "ar", "bg", "bn", "ca", "cs", "da", "de", "el", "en", "es",
                "et", "fa", "fi", "fr", "gu", "he", "hi", "hr", "hu", "id",
                "it", "ja", "kn", "ko", "lt", "lv", "ml", "mr", "ms", "nb",
                "nl", "no", "pl", "pt", "ro", "ru", "sk", "sl", "sr", "sv",
                "sw", "ta", "te", "th", "tr", "uk", "ur", "vi", "zh"
            ],
            "enumTitles": [
                "Arabic (ar)", "Bulgarian (bg)", "Bengali (bn)", "Catalan (ca)",
                "Czech (cs)", "Danish (da)", "German (de)", "Greek (el)",
                "English (en)", "Spanish (es)", "Estonian (et)", "Persian (fa)",
                "Finnish (fi)", "French (fr)", "Gujarati (gu)", "Hebrew (he)",
                "Hindi (hi)", "Croatian (hr)", "Hungarian (hu)", "Indonesian (id)",
                "Italian (it)", "Japanese (ja)", "Kannada (kn)", "Korean (ko)",
                "Lithuanian (lt)", "Latvian (lv)", "Malayalam (ml)", "Marathi (mr)",
                "Malay (ms)", "Norwegian Bokmål (nb)", "Dutch (nl)", "Norwegian (no)",
                "Polish (pl)", "Portuguese (pt)", "Romanian (ro)", "Russian (ru)",
