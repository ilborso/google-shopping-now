                "Swahili (sw)", "Tamil (ta)", "Telugu (te)", "Thai (th)",
                "Turkish (tr)", "Ukrainian (uk)", "Urdu (ur)", "Vietnamese (vi)",
                "Chinese (zh)"
            ]
        },
        "gl": {
            "title": "Country",
            "type": "string",
            "description": "Country perspective for Google Shopping results (ISO 3166-1 alpha-2 code).",
            "editor": "select",
            "default": "us",
            "prefill": "us",
            "enum": [
                "ar", "au", "at", "be", "br", "ca", "cl", "co", "cz", "dk",
                "eg", "fi", "fr", "de", "gr", "hk", "hu", "in", "id", "ie",
                "il", "it", "jp", "ke", "my", "mx", "nl", "nz", "ng", "no",
                "pk", "pe", "ph", "pl", "pt", "ro", "ru", "sa", "sg", "za",
                "kr", "es", "se", "ch", "tw", "th", "tr", "ua", "ae", "gb",
                "us", "vn"
            ],
            "enumTitles": [
